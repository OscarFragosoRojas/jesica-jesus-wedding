---
// Botanical Eucalyptus Leaves & Pastel Rose Petals floating canvas animation
---

<canvas id="petals-canvas" class="petals-canvas"></canvas>

<style>
  .petals-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }
</style>

<script>
  function initPetals() {
    const canvas = document.getElementById('petals-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    interface Leaf {
      x: number;
      y: number;
      size: number;
      speedY: number;
      speedX: number;
      opacity: number;
      rotation: number;
      rotationSpeed: number;
      color: string;
      isLeaf: boolean;
    }

    const leaves: Leaf[] = [];
    const leafCount = 32;

    const colors = [
      'rgba(107, 124, 104, 0.45)', // Eucalyptus Sage
      'rgba(163, 178, 160, 0.55)', // Light Sage
      'rgba(158, 90, 103, 0.35)',  // Pastel Wine
      'rgba(214, 165, 174, 0.45)'  // Dusty Rose
    ];

    for (let i = 0; i < leafCount; i++) {
      leaves.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 10 + 5,
        speedY: Math.random() * 0.7 + 0.3,
        speedX: (Math.random() - 0.5) * 0.5,
        opacity: Math.random() * 0.6 + 0.3,
        rotation: Math.random() * 360,
        rotationSpeed: (Math.random() - 0.5) * 1.2,
        color: colors[Math.floor(Math.random() * colors.length)],
        isLeaf: Math.random() > 0.3
      });
    }

    function animate() {
      ctx.clearRect(0, 0, width, height);

      leaves.forEach((p) => {
        p.y += p.speedY;
        p.x += Math.sin(p.y * 0.01) * p.speedX;
        p.rotation += p.rotationSpeed;

        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        }

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rotation * Math.PI) / 180);
        ctx.globalAlpha = p.opacity;

        ctx.beginPath();
        if (p.isLeaf) {
          // Draw delicate eucalyptus leaf shape
          ctx.moveTo(0, -p.size);
          ctx.bezierCurveTo(p.size * 0.6, -p.size * 0.3, p.size * 0.6, p.size * 0.3, 0, p.size);
          ctx.bezierCurveTo(-p.size * 0.6, p.size * 0.3, -p.size * 0.6, -p.size * 0.3, 0, -p.size);
          ctx.fillStyle = p.color;
          ctx.fill();

          // Leaf vein line
          ctx.beginPath();
          ctx.moveTo(0, -p.size * 0.8);
          ctx.lineTo(0, p.size * 0.8);
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
          ctx.lineWidth = 0.8;
          ctx.stroke();
        } else {
          // Soft petal shape
          ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.fill();
        }

        ctx.restore();
      });

      requestAnimationFrame(animate);
    }

    animate();
  }

  document.addEventListener('DOMContentLoaded', initPetals);
</script>
