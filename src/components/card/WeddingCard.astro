---
import CardTopPhoto from "./CardTopPhoto.astro";
import CardCountdown from "./CardCountdown.astro";
import CardParents from "./CardParents.astro";
import CardNamesDate from "./CardNamesDate.astro";
import CardLocations from "./CardLocations.astro";
import CardItinerary from "./CardItinerary.astro";
---

<div class="card-wrapper fade-in-element">
  <div class="wedding-card" id="wedding-card-el">
    <!-- 1. Principal Top Photo with Monogram Initials -->
    <CardTopPhoto />

    <!-- 2. Integrated Countdown Timer (Debajo de la foto principal) -->
    <CardCountdown />

    <!-- 3. Intro Verse & Parents of Groom & Bride -->
    <CardParents />

    <!-- 4. Grand Calligraphy Names & Date -->
    <CardNamesDate />

    <!-- 5. Ceremony & Reception Locations with Google Maps -->
    <CardLocations />

    <!-- 6. Activities Itinerary -->
    <CardItinerary />
  </div>
</div>

<style>
  .card-wrapper {
    max-width: 520px;
    margin: 14px auto 16px;
    padding: 0 16px;
    position: relative;
    z-index: 2;
  }

  .wedding-card {
    background: #faf7f2;
    border: 1px solid #e5dec9;
    border-radius: 24px;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.08),
      0 2px 10px rgba(158, 90, 103, 0.05);
    position: relative;
    padding: 50px 30px 40px;
    text-align: center;
    overflow: hidden;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wedding-card.card-revealed {
    animation: cardGrandReveal 1.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes cardGrandReveal {
    0% {
      opacity: 0.3;
      transform: translateY(32px) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 480px) {
    .card-wrapper {
      margin: 6px auto 12px;
      padding: 0 8px;
    }
    .wedding-card {
      padding: 36px 14px 28px;
      border-radius: 20px;
    }
  }
</style>

<script>
  document.addEventListener("envelopeOpened", () => {
    const card = document.getElementById("wedding-card-el");
    if (card) {
      card.classList.add("card-revealed");
    }
  });
</script>
