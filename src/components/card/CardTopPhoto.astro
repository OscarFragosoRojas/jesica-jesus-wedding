---
// CardTopPhoto: Clean photo with NUESTRA BODA pill, simple J | S initials, deep gradient fade & scroll cue
---

<div class="card-top-photo-section">
  <div class="photo-container">
    <img
      src="/images/beach_couple.jpg"
      alt="Jesús & Jesica Saray en la playa"
      class="principal-photo"
    />

    <!-- Subtle contrast scrim at top for pristine text legibility -->
    <div class="photo-scrim-top"></div>

    <!-- Soft, deep gradual gradient at bottom seamlessly melting into the card -->
    <div class="photo-gradient-fade"></div>

    <!-- Top Overlay: NUESTRA BODA pill + simple J | S monogram -->
    <div class="photo-overlay-content">
      <div class="hero-pill-badge">
        <span class="pill-heart">🤍</span>
        <span class="pill-text">NUESTRA BODA</span>
        <span class="pill-heart">🤍</span>
      </div>
      <h1 class="monogram-simple">J <span class="monogram-divider">|</span> S</h1>
    </div>

    <!-- Subtle scroll cue at the bottom of the gradient fade -->
    <div class="scroll-cue">
      <span class="scroll-cue-text">DESLIZA PARA VER MÁS</span>
      <svg class="scroll-cue-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4">
        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>
</div>

<style>
  .card-top-photo-section {
    width: calc(100% + 60px);
    margin: -50px -30px 10px -30px;
    position: relative;
  }

  .photo-container {
    position: relative;
    width: 100%;
    height: 460px;
    overflow: hidden;
  }

  .principal-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
    display: block;
    transform: scale(1.01);
  }

  /* Shimmer light effect when invitation opens */
  .photo-container::after {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.25) 50%,
      transparent 100%
    );
    transform: skewX(-22deg);
    pointer-events: none;
    z-index: 5;
  }

  :global(.card-revealed) .photo-container::after {
    animation: photoSheen 1.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s forwards;
  }

  @keyframes photoSheen {
    0% {
      left: -120%;
    }
    100% {
      left: 220%;
    }
  }

  /* Scrim on top so white text is easily readable over the sky */
  .photo-scrim-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 48%;
    background: linear-gradient(
      180deg,
      rgba(35, 14, 18, 0.48) 0%,
      rgba(35, 14, 18, 0.20) 45%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* The smooth gradient fade melting seamlessly into the card (#FAF7F2) */
  .photo-gradient-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 240px;
    background: linear-gradient(
      180deg,
      rgba(250, 247, 242, 0) 0%,
      rgba(250, 247, 242, 0.10) 25%,
      rgba(250, 247, 242, 0.38) 50%,
      rgba(250, 247, 242, 0.78) 75%,
      rgba(250, 247, 242, 0.96) 90%,
      #FAF7F2 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .photo-overlay-content {
    position: absolute;
    top: 26px;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
    text-align: center;
    padding: 0 16px;
  }

  /* Clean NUESTRA BODA pill badge matching reference */
  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.45);
    padding: 6px 18px;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 2.5px;
    color: #FFFFFF;
    font-weight: 600;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    margin-bottom: 10px;
  }

  .pill-heart {
    font-size: 0.62rem;
    opacity: 0.9;
    display: inline-block;
    line-height: 1;
  }

  .pill-text {
    display: inline-block;
    line-height: 1;
  }

  /* J | S sencillos y elegantes */
  .monogram-simple {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 300;
    color: #FFFFFF;
    letter-spacing: 8px;
    line-height: 1;
    margin: 0;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
  }

  .monogram-divider {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 200;
    margin: 0 4px;
  }

  /* Subtle scroll cue indicator at the bottom of the gradient */
  .scroll-cue {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    z-index: 3;
    pointer-events: none;
    color: #8C7677;
    opacity: 0.85;
    animation: cueBounce 2.5s ease-in-out infinite;
  }

  .scroll-cue-text {
    font-family: var(--font-heading);
    font-size: 0.58rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .scroll-cue-arrow {
    stroke: currentColor;
    opacity: 0.85;
  }

  @keyframes cueBounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 480px) {
    .card-top-photo-section {
      margin: -36px -14px 10px -14px;
      width: calc(100% + 28px);
    }
    .photo-container {
      height: 420px;
    }
    .photo-overlay-content {
      top: 20px;
    }
    .hero-pill-badge {
      font-size: 0.58rem;
      letter-spacing: 2.2px;
      padding: 5px 14px;
      gap: 6px;
      margin-bottom: 6px;
    }
    .monogram-simple {
      font-size: 2.5rem;
      letter-spacing: 6px;
    }
    .photo-gradient-fade {
      height: 200px;
    }
    .scroll-cue {
      bottom: 12px;
    }
    .scroll-cue-text {
      font-size: 0.52rem;
      letter-spacing: 2.4px;
    }
  }
</style>
