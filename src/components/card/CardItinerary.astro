---
// CardItinerary: Itinerario de actividades inside a soft watercolor wash card
---

<div class="itinerary-wrapper">
  <h3 class="itinerary-header">ITINERARIO DE ACTIVIDADES</h3>

  <div class="itinerary-wash-card">
    <div class="itinerary-item">
      <div class="itinerary-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time">16:00 HRS</span>
        <p class="event">Ceremonia Religiosa</p>
      </div>
    </div>

    <div class="itinerary-item">
      <div class="itinerary-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M8 22h8M12 11v11M19 3H5l1 8a6 6 0 0 0 12 0l1-8z"></path>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time">17:30 HRS</span>
        <p class="event">Cóctel de Bienvenida</p>
      </div>
    </div>

    <div class="itinerary-item">
      <div class="itinerary-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time">18:30 HRS</span>
        <p class="event">Entrada de los Novios</p>
      </div>
    </div>

    <div class="itinerary-item">
      <div class="itinerary-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"
          ></path>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time">19:30 HRS</span>
        <p class="event">Banquete Nuptial</p>
      </div>
    </div>

    <div class="itinerary-item">
      <div class="itinerary-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time">21:00 HRS</span>
        <p class="event">Vals & Fiesta</p>
      </div>
    </div>
  </div>

  <div class="botanical-flourish">
    <svg width="100" height="20" viewBox="0 0 200 40" fill="none">
      <path d="M10 20 Q100 35 190 20" stroke="#6B7C68" stroke-width="1.5"></path>
      <path d="M60 20 C 50 10, 40 25, 55 20 Z" fill="#8F9E8B"></path>
      <path d="M140 20 C 150 10, 160 25, 145 20 Z" fill="#8F9E8B"></path>
    </svg>
  </div>

  <p class="closing-hope">CON ILUSIÓN ESPERAMOS CELEBRAR CONTIGO</p>
</div>

<style>
  .itinerary-wrapper {
    margin: 40px 0 20px;
    text-align: center;
  }

  .itinerary-header {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 4px;
    color: var(--color-wine-dark);
    margin-bottom: 20px;
  }

  .itinerary-wash-card {
    background: radial-gradient(circle at center, #edf2ec 0%, #e2eae0 100%);
    border: 1px solid #d1ddd0;
    border-radius: var(--radius-md);
    padding: 30px 24px;
    text-align: left;
    max-width: 420px;
    margin: 0 auto;
    box-shadow: inset 0 0 20px rgba(107, 124, 104, 0.08);
  }

  .itinerary-item {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .itinerary-item:last-child {
    margin-bottom: 0;
  }

  .itinerary-icon {
    width: 40px;
    height: 40px;
    color: #4e5d4c;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .itinerary-info .time {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: #4e5d4c;
    font-weight: 700;
    display: block;
  }

  .itinerary-info .event {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: #2c352b;
    font-weight: 600;
    margin-top: 2px;
  }

  .botanical-flourish {
    margin: 20px 0 10px;
  }

  .closing-hope {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    letter-spacing: 3px;
    color: #2d2523;
    margin-top: 14px;
    font-weight: 600;
  }
</style>
