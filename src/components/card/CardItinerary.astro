---
// CardItinerary: Itinerario de actividades inside a soft watercolor wash card
---

<div class="itinerary-wrapper">
  <h3 class="itinerary-header">ITINERARIO DE ACTIVIDADES</h3>

  <div class="itinerary-wash-card">
    <div class="itinerary-item">
      <div class="itinerary-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time">13:45 HRS</span>
        <p class="event">Ceremonia Religiosa</p>
        <span class="venue-sub">Iglesia San Miguel Coatlinchán</span>
      </div>
    </div>

    <div class="itinerary-item">
      <div class="itinerary-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M8 22h8M12 11v11M19 3H5l1 8a6 6 0 0 0 12 0l1-8z"></path>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time">15:50 HRS</span>
        <p class="event">Recepción</p>
        <span class="venue-sub">Salón De Fiestas Diamante</span>
      </div>
    </div>

    <div class="itinerary-item party-item">
      <div class="itinerary-icon party-icon">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
      </div>
      <div class="itinerary-info">
        <span class="time highlight-time">A CONTINUACIÓN</span>
        <p class="event highlight-event">Banquete y Celebración</p>
        <span class="venue-sub">Música, brindis y momentos para compartir</span>
      </div>
    </div>
  </div>

  <div class="botanical-flourish">
    <svg width="100" height="20" viewBox="0 0 200 40" fill="none">
      <path d="M10 20 Q100 35 190 20" stroke="#6B7C68" stroke-width="1.5"></path>
      <path d="M60 20 C 50 10, 40 25, 55 20 Z" fill="#8F9E8B"></path>
      <path d="M140 20 C 150 10, 160 25, 145 20 Z" fill="#8F9E8B"></path>
    </svg>
  </div>

  <p class="closing-hope">CON ILUSIÓN ESPERAMOS CELEBRAR CONTIGO</p>
</div>

<style>
  .itinerary-wrapper {
    margin: 40px 0 20px;
    text-align: center;
  }

  .itinerary-header {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 4px;
    color: var(--color-wine-dark);
    margin-bottom: 20px;
  }

  .itinerary-wash-card {
    background: radial-gradient(circle at center, #edf2ec 0%, #e2eae0 100%);
    border: 1px solid #d1ddd0;
    border-radius: var(--radius-md);
    padding: 30px 24px;
    text-align: left;
    max-width: 420px;
    margin: 0 auto;
    box-shadow: inset 0 0 20px rgba(107, 124, 104, 0.08);
  }

  .itinerary-item {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .itinerary-item:last-child {
    margin-bottom: 0;
  }

  .itinerary-icon {
    width: 40px;
    height: 40px;
    color: #4e5d4c;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .itinerary-info .time {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: #4e5d4c;
    font-weight: 700;
    display: block;
  }

  .itinerary-info .event {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: #2c352b;
    font-weight: 600;
    margin-top: 2px;
  }

  .venue-sub {
    font-family: var(--font-body);
    font-size: 0.73rem;
    color: #637361;
    display: block;
    margin-top: 3px;
    letter-spacing: 0.5px;
  }

  .highlight-time {
    color: var(--color-wine-dark) !important;
  }

  .highlight-event {
    color: var(--color-wine-dark) !important;
  }

  .party-icon {
    color: var(--color-wine) !important;
  }

  .botanical-flourish {
    margin: 20px 0 10px;
  }

  .closing-hope {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    letter-spacing: 3px;
    color: #2d2523;
    margin-top: 14px;
    font-weight: 600;
  }
</style>
