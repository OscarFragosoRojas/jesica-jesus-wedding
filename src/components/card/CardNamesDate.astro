---
// CardNamesDate: Calligraphy names & Date display
---

<div class="names-date-wrapper">
  <div class="names-calligraphy-section">
    <div class="side-leaves-decor">
      <svg width="40" height="120" viewBox="0 0 50 150" fill="none">
        <path d="M25 0 Q10 75 25 150" stroke="#8F9E8B" stroke-width="1.5"></path>
        <circle cx="15" cy="30" r="8" fill="#A3B2A0" opacity="0.7"></circle>
        <circle cx="35" cy="70" r="9" fill="#8F9E8B" opacity="0.8"></circle>
        <circle cx="18" cy="110" r="7" fill="#9E5A67" opacity="0.4"></circle>
      </svg>
    </div>

    <div class="names-box">
      <h2 class="script-name">Jesús Galicia</h2>
      <span class="script-ampersand">&</span>
      <h2 class="script-name">Jesica Saray</h2>
    </div>

    <div class="side-leaves-decor flip-decor">
      <svg width="40" height="120" viewBox="0 0 50 150" fill="none">
        <path d="M25 0 Q40 75 25 150" stroke="#8F9E8B" stroke-width="1.5"></path>
        <circle cx="35" cy="30" r="8" fill="#A3B2A0" opacity="0.7"></circle>
        <circle cx="15" cy="70" r="9" fill="#8F9E8B" opacity="0.8"></circle>
        <circle cx="32" cy="110" r="7" fill="#9E5A67" opacity="0.4"></circle>
      </svg>
    </div>
  </div>

  <p class="honor-invite-text">
    TENEMOS EL HONOR DE INVITARTE A NUESTRA BODA
  </p>

  <div class="date-display-container">
    <div class="date-line"></div>
    <div class="date-flex">
      <span class="day-name">SÁBADO</span>
      <span class="date-number">19</span>
      <div class="month-year">
        <span>DICIEMBRE</span>
        <span class="year-num">2026</span>
      </div>
    </div>
    <div class="date-line"></div>
  </div>

  <div class="botanical-flourish">
    <svg width="120" height="24" viewBox="0 0 200 40" fill="none">
      <path d="M10 20 Q100 35 190 20" stroke="#6B7C68" stroke-width="1.5"></path>
      <path d="M60 20 C 50 10, 40 25, 55 20 Z" fill="#8F9E8B"></path>
      <path d="M140 20 C 150 10, 160 25, 145 20 Z" fill="#8F9E8B"></path>
      <circle cx="100" cy="22" r="3" fill="#9E5A67"></circle>
    </svg>
  </div>

  <div class="section-separator-line"></div>
</div>

<style>
  .names-date-wrapper {
    text-align: center;
  }

  .names-calligraphy-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 36px 0 16px;
  }

  .names-box {
    text-align: center;
  }

  .script-name {
    font-family: var(--font-script);
    font-size: 4.2rem;
    color: var(--color-wine-dark);
    font-weight: 400;
    line-height: 1.1;
  }

  .script-ampersand {
    font-family: var(--font-script);
    font-size: 2.8rem;
    color: var(--color-gold);
    display: block;
    margin: -8px 0;
  }

  .side-leaves-decor {
    opacity: 0.85;
  }

  .flip-decor {
    transform: scaleX(-1);
  }

  .honor-invite-text {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 3px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .date-display-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 24px 0 10px;
  }

  .date-line {
    width: 60px;
    height: 1px;
    background: #d5cbb9;
  }

  .date-flex {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .day-name {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 3px;
    color: var(--color-wine);
  }

  .date-number {
    font-family: var(--font-serif);
    font-size: 3.6rem;
    font-weight: 400;
    line-height: 1;
    color: #2d2523;
  }

  .month-year {
    display: flex;
    flex-direction: column;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 2.5px;
    color: var(--color-wine);
  }

  .year-num {
    color: var(--color-text-muted);
    font-size: 0.7rem;
  }

  .botanical-flourish {
    margin: 12px 0 20px;
  }

  .section-separator-line {
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #d5cbb9, transparent);
    margin: 30px auto;
  }

  @media (max-width: 480px) {
    .script-name {
      font-size: 3.2rem;
    }
    .date-number {
      font-size: 2.8rem;
    }
  }
</style>
