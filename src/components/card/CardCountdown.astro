---
// CardCountdown: Minimalist, elegant countdown with "Faltan solo PARA NUESTRO GRAN DÍA"
---

<div class="countdown-clean-section">
  <!-- Clean Header matching reference -->
  <div class="countdown-heading-block">
    <span class="script-subtitle">Faltan solo</span>
    <h2 class="serif-title">PARA NUESTRO GRAN DÍA</h2>
  </div>

  <!-- 4 Clean Rounded Timer Cards -->
  <div class="timer-grid">
    <div class="timer-card">
      <span id="days" class="timer-number">00</span>
      <span class="timer-label">DÍAS</span>
    </div>

    <div class="timer-card">
      <span id="hours" class="timer-number">00</span>
      <span class="timer-label">HORAS</span>
    </div>

    <div class="timer-card">
      <span id="minutes" class="timer-number">00</span>
      <span class="timer-label">MINUTOS</span>
    </div>

    <div class="timer-card">
      <span id="seconds" class="timer-number">00</span>
      <span class="timer-label">SEGUNDOS</span>
    </div>
  </div>
</div>

<style>
  .countdown-clean-section {
    margin: 14px auto 30px;
    padding: 0 4px;
    text-align: center;
    max-width: 460px;
  }

  .countdown-heading-block {
    margin-bottom: 22px;
  }

  .script-subtitle {
    font-family: var(--font-script);
    font-size: 2.6rem;
    color: #c28891;
    display: block;
    line-height: 1.1;
    margin-bottom: 2px;
    font-weight: 400;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
  }

  .serif-title {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    letter-spacing: 3.5px;
    color: #403436;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0;
  }

  .timer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    align-items: stretch;
  }

  .timer-card {
    background: #FFFFFF;
    border: 1.5px solid #EFE4E7;
    border-radius: 18px;
    padding: 16px 6px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 6px 20px rgba(158, 90, 103, 0.06),
      0 1px 3px rgba(0, 0, 0, 0.02);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .timer-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-wine-pastel);
    box-shadow:
      0 10px 24px rgba(158, 90, 103, 0.12),
      0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .timer-number {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 600;
    color: #2B2223;
    line-height: 1;
    letter-spacing: 0.5px;
  }

  .timer-label {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    letter-spacing: 2px;
    color: #B58C62;
    margin-top: 8px;
    font-weight: 600;
    text-transform: uppercase;
  }

  @media (max-width: 480px) {
    .countdown-clean-section {
      margin: 8px auto 24px;
    }
    .script-subtitle {
      font-size: 2.15rem;
    }
    .serif-title {
      font-size: 0.72rem;
      letter-spacing: 2.8px;
    }
    .timer-grid {
      gap: 7px;
    }
    .timer-card {
      border-radius: 15px;
      padding: 12px 4px 10px;
    }
    .timer-number {
      font-size: 1.7rem;
    }
    .timer-label {
      font-size: 0.52rem;
      letter-spacing: 1.5px;
      margin-top: 6px;
    }
  }
</style>

<script>
  function startCountdown() {
    const targetDate = new Date("2026-12-19T13:45:00").getTime();

    const daysEl = document.getElementById("days");
    const hoursEl = document.getElementById("hours");
    const minutesEl = document.getElementById("minutes");
    const secondsEl = document.getElementById("seconds");

    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;

    function update() {
      const now = new Date().getTime();
      const difference = targetDate - now;

      if (difference <= 0) {
        daysEl.innerText = "00";
        hoursEl.innerText = "00";
        minutesEl.innerText = "00";
        secondsEl.innerText = "00";
        return;
      }

      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      const hours = Math.floor(
        (difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
      );
      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((difference % (1000 * 60)) / 1000);

      daysEl.innerText = String(days).padStart(2, "0");
      hoursEl.innerText = String(hours).padStart(2, "0");
      minutesEl.innerText = String(minutes).padStart(2, "0");
      secondsEl.innerText = String(seconds).padStart(2, "0");
    }

    update();
    setInterval(update, 1000);
  }

  document.addEventListener("DOMContentLoaded", startCountdown);
</script>
