---
// Interactive Envelope Opening Modal with Wax Seal and Pastel Theme
---

<div id="envelope-overlay" class="envelope-overlay">
  <div class="envelope-wrapper">
    <div class="envelope-card">
      <div class="couple-names-preview">
        <h2>Jesús Galicia Galicia</h2>
        <span class="ampersand">&</span>
        <h2>Jesica Saray Chavarría Vázquez</h2>
      </div>

      <div class="seal-container" id="open-envelope-btn">
        <div class="wax-seal">
          <div class="seal-ring"></div>
          <span class="seal-text">J & S</span>
        </div>
        <div class="tap-hint">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 5v14M5 12l7 7 7-7"></path>
          </svg>
          <span>Toca aquí para abrir la invitación</span>
        </div>
      </div>

      <p class="envelope-footer-note">Sábado 19 de Diciembre, 2026</p>
    </div>
  </div>
</div>

<style>
  .envelope-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: radial-gradient(circle at center, #5a2a33 0%, #2d1419 100%);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    transition:
      opacity 1.2s cubic-bezier(0.65, 0, 0.35, 1),
      visibility 1.2s;
  }

  .envelope-overlay.is-opened {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .envelope-wrapper {
    max-width: 460px;
    width: 100%;
    perspective: 1000px;
  }

  .envelope-card {
    background: linear-gradient(145deg, #faf7f2 0%, #f1ece3 100%);
    border: 1.5px solid var(--color-wine-pastel);
    border-radius: 20px;
    padding: 40px 24px;
    text-align: center;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.5),
      0 0 25px rgba(214, 165, 174, 0.3);
    position: relative;
    overflow: hidden;
    animation: floatEnvelope 4s ease-in-out infinite;
  }

  .envelope-card::before {
    content: "";
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    bottom: 10px;
    border: 1px dashed var(--color-wine-pastel);
    border-radius: 14px;
    pointer-events: none;
  }

  @keyframes floatEnvelope {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .couple-names-preview {
    margin: 16px 0 26px;
  }

  .couple-names-preview h2 {
    font-family: var(--font-script);
    font-size: 2.2rem;
    color: var(--color-wine-dark);
    line-height: 1.2;
    font-weight: 400;
  }

  .ampersand {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--color-gold);
    display: block;
    margin: 4px 0;
  }

  .seal-container {
    margin: 28px auto 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .seal-container:hover {
    transform: scale(1.06);
  }

  .wax-seal {
    width: 76px;
    height: 76px;
    background: radial-gradient(
      circle at 35% 35%,
      #b87380 0%,
      #9e5a67 60%,
      #7a3e4a 100%
    );
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 8px 20px rgba(158, 90, 103, 0.4),
      inset 0 2px 4px rgba(255, 255, 255, 0.4);
    position: relative;
    border: 2px solid #f4e8ce;
  }

  .seal-ring {
    position: absolute;
    width: 62px;
    height: 62px;
    border: 1px dashed rgba(255, 255, 255, 0.6);
    border-radius: 50%;
  }

  .seal-text {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: #fff;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .tap-hint {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--color-wine-dark);
    font-weight: 500;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(5px);
    }
    60% {
      transform: translateY(2px);
    }
  }

  .envelope-footer-note {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    letter-spacing: 1px;
    margin-top: 18px;
  }
</style>

<script>
  function setupEnvelope() {
    const btn = document.getElementById("open-envelope-btn");
    const overlay = document.getElementById("envelope-overlay");

    if (!btn || !overlay) return;

    btn.addEventListener("click", () => {
      overlay.classList.add("is-opened");

      const bgAudio = document.getElementById("bg-music") as HTMLAudioElement;
      if (bgAudio) {
        bgAudio.play().catch(() => {});
        const musicBtn = document.getElementById("music-toggle-btn");
        if (musicBtn) musicBtn.classList.add("is-playing");
      }

      document.dispatchEvent(new Event("envelopeOpened"));
    });
  }

  document.addEventListener("DOMContentLoaded", setupEnvelope);
</script>
