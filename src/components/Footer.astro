---
// Footer Component with Monogram, Hashtag & Warm Parchment Tone
---

<footer class="invitation-footer">
  <div class="footer-container">
    <div class="monogram-badge">J | S</div>
    <h3 class="footer-names">
      Jesús Galicia Galicia & Jesica Saray Chavarría Vázquez
    </h3>
    <p class="hashtag">#BodaJesusYJesica2026</p>
    <p class="footer-note">
      ¡Gracias por ser parte de nuestra historia de amor!
    </p>
    <div class="footer-year">2026 • Texcoco, Estado de México.</div>
  </div>
</footer>

<style>
  .invitation-footer {
    padding: 50px 20px 60px;
    background: radial-gradient(circle at top, #5a2a33 0%, #2d1419 100%);
    color: #fff;
    text-align: center;
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-wine-pastel);
  }

  .footer-container {
    max-width: 520px;
    margin: 0 auto;
  }

  .monogram-badge {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-gold-light);
    letter-spacing: 4px;
    margin-bottom: 12px;
  }

  .footer-names {
    font-family: var(--font-script);
    font-size: 2.2rem;
    font-weight: 400;
    color: var(--color-wine-pastel);
    line-height: 1.2;
  }

  .hashtag {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 2px;
    color: var(--color-gold-light);
    margin: 16px 0 10px;
  }

  .footer-note {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
  }

  .footer-year {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 24px;
    text-transform: uppercase;
  }
</style>
