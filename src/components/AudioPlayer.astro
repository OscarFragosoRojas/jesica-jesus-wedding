---
// Floating Romantic Audio Player with Pastel Theme
---

<div class="audio-player-container">
  <audio id="bg-music" loop src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=romantic-wedding-piano-112658.mp3"></audio>

  <button id="music-toggle-btn" class="music-btn" aria-label="Reproducir o pausar música">
    <div class="sound-wave">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <span class="music-label">Música</span>
  </button>
</div>

<style>
  .audio-player-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
  }

  .music-btn {
    background: rgba(158, 90, 103, 0.92);
    border: 1px solid var(--color-wine-pastel);
    color: #FFF;
    padding: 10px 18px;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(158, 90, 103, 0.3);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }

  .music-btn:hover {
    transform: scale(1.05);
    background: var(--color-wine-dark);
    box-shadow: 0 8px 24px rgba(158, 90, 103, 0.4);
  }

  .music-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .sound-wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
  }

  .sound-wave span {
    width: 3px;
    height: 100%;
    background: var(--color-gold-light);
    border-radius: 2px;
    transform-origin: bottom;
    transition: transform 0.3s ease;
  }

  .music-btn.is-playing .sound-wave span:nth-child(1) {
    animation: wave 1.2s infinite ease-in-out;
  }
  .music-btn.is-playing .sound-wave span:nth-child(2) {
    animation: wave 0.8s infinite ease-in-out 0.2s;
  }
  .music-btn.is-playing .sound-wave span:nth-child(3) {
    animation: wave 1.4s infinite ease-in-out 0.4s;
  }
  .music-btn.is-playing .sound-wave span:nth-child(4) {
    animation: wave 1s infinite ease-in-out 0.1s;
  }

  @keyframes wave {
    0%, 100% { transform: scaleY(0.3); }
    50% { transform: scaleY(1); }
  }
</style>

<script>
  function setupAudio() {
    const music = document.getElementById('bg-music') as HTMLAudioElement;
    const toggleBtn = document.getElementById('music-toggle-btn');

    if (!music || !toggleBtn) return;

    toggleBtn.addEventListener('click', () => {
      if (music.paused) {
        music.play();
        toggleBtn.classList.add('is-playing');
      } else {
        music.pause();
        toggleBtn.classList.remove('is-playing');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupAudio);
</script>
