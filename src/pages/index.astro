---
import Layout from "../layouts/Layout.astro";
import EnvelopeModal from "../components/EnvelopeModal.astro";
import PetalsCanvas from "../components/PetalsCanvas.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import WeddingCard from "../components/card/WeddingCard.astro";
import ThankYouCard from "../components/ThankYouCard.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
	<!-- Opening Envelope Modal with Wax Seal -->
	<EnvelopeModal />

	<!-- Dynamic Background Eucalyptus Leaves & Petals Canvas -->
	<PetalsCanvas />

	<!-- Floating Audio Player -->
	<AudioPlayer />

	<!-- Main Page Content -->
	<main class="invitation-main">
		<!-- Main Vertical Invitation Card (with integrated Countdown & design) -->
		<WeddingCard />

		<!-- Carta de Agradecimiento & Mensaje Especial de los Novios -->
		<ThankYouCard />
	</main>

	<!-- Footer -->
	<Footer />
</Layout>

<style>
	.invitation-main {
		position: relative;
		z-index: 2;
		overflow-x: hidden;
		padding-top: 20px;
	}
</style>
